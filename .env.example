# =======================================================
# Email Generator & Verification Cluster Configuration
# =======================================================

NODE_ENV=production

# -------------------------------------------------------
# NODE ROLE & IDENTIFICATION
# -------------------------------------------------------
NODE_ROLE=master
SERVER_ID=server_master_node

# -------------------------------------------------------
# SINGLE DESIGNATED WEBHOOK RECEIVER SERVER
# -------------------------------------------------------
# Set IS_WEBHOOK_RECEIVER=true on ONLY ONE SERVER (e.g. Server 1)
# On Server 2 & Server 3 set IS_WEBHOOK_RECEIVER=false
IS_WEBHOOK_RECEIVER=true

# The reachable callback URL of that ONE single server (e.g. http://10.0.0.1:3000)
# ALL 3 servers will send this exact URL to No2Bounce
WEBHOOK_CALLBACK_BASE_URL=http://127.0.0.1:3000
WEBHOOK_SERVER_PORT=3000

# -------------------------------------------------------
# SOURCE MONGODB (Used by Master Node)
# -------------------------------------------------------
SOURCE_MONGODB_URI=mongodb://localhost:27017
SOURCE_PEOPLE_DB=dg_data
SOURCE_PEOPLE_COLLECTION=es_cont_email
SOURCE_BATCH_SIZE=10000
SOURCE_BATCH_DELAY_MS=0
# Optional: set to 'strict_true' if collection contains only boolean website: true
SOURCE_WEBSITE_QUERY_MODE=true

# -------------------------------------------------------
# SHARED REDIS CLUSTER (Must be reachable by all servers)
# -------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -------------------------------------------------------
# PARQUET STORAGE SETTINGS
# -------------------------------------------------------
PARQUET_BASE_DIR=./data
PARQUET_VALID_DIR=./data/valid
PARQUET_WAITING_WEBHOOK_DIR=./data/invalid/waiting_webhook_v6
PARQUET_PERM_INVALID_DIR=./data/invalid/permanent_invalid_cache
PARQUET_P2_COMPLETED_DIR=./data/invalid/process2_completed
PARQUET_FAILED_PERM_DIR=./data/invalid/failed_permanent
PARQUET_MIN_CAPACITY=50000
PARQUET_MAX_CAPACITY=500000

# -------------------------------------------------------
# VALIDATION ENDPOINTS
# -------------------------------------------------------
CACHE_VALIDATION_URL=https://cachevalidation.no2bounce.com/api/cache/check
CACHE_VALIDATION_TOKEN=your_token_here

WEBHOOK_VALIDATION_URL=https://verifyv6.no2bounce.com/api/v2/single-webhook-validation
WEBHOOK_API_TOKEN=your_token_here

# -------------------------------------------------------
# WORKER TUNING (Tuned for 16 Cores & High RAM)
# -------------------------------------------------------
WORKER_CONCURRENCY=120
MAX_JOB_RETRIES=2
RETRY_BACKOFF_MS=1000
