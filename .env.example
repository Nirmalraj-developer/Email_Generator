SERVER_ID=m10644_v6_runner

# INPUT JSONL SLICE DIRECTORY (Reads all .jsonl/.json except all_verifications_unique.jsonl)
INPUT_DIR=/root/no2bounce-webhook/validation/output
EXCLUDED_FILES=all_verifications_unique.jsonl

# VERIFY V6 API & RATE TARGET (Up to 3,000 API calls/sec)
WEBHOOK_VALIDATION_URL=https://verifyv6.no2bounce.com/api/v2/single-webhook-validation
WEBHOOK_API_TOKEN=YOUR_VERIFY_V6_API_KEY
TARGET_RPS=3000
MAX_CONCURRENCY=1500
API_TIMEOUT_MS=15000
MAX_RETRIES=3

# WEBHOOK RECEIVER (Listens on this server)
WEBHOOK_PORT=3000
WEBHOOK_PATH=/api/webhook/validation
WEBHOOK_CALLBACK_BASE_URL=http://173.249.52.244:3000

# 3-STAGE PARQUET STORAGE
PARQUET_BASE_DIR=./data
PARQUET_MAX_CAPACITY=1000000

# CHECKPOINT & LOGS
CHECKPOINT_FILE=./data/processed_ids.log
ERROR_LOG_FILE=./logs/error.log
STATS_INTERVAL_MS=1000
